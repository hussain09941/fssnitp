# Optional: absolute path to your Pascal VOC 2012 dataset folder.
# Example: VOC_DATASET_PATH=/Users/yourname/datasets/VOC2012_train_val
VOC_DATASET_PATH=

# Training defaults from the original project are 1000 train episodes/fold
# and 100 test episodes/fold. Lower values are useful for a quick smoke test.
FEWSHOT_EPISODES_PER_FOLD=1000
FEWSHOT_EPISODES_PER_TEST_FOLD=100
